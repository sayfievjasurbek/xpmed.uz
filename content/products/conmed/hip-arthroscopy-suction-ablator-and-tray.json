  "features": [
    {
      "id": "feature-1",
      "title": {
        "ru": "LightWave®, удлинённый длина аспирационный аблятор",
        "en": "LightWave®, Extended Length Suction Ablator"
      },
      "text": {
        "ru": "Конструкция LightWave включает цельнолитую рукоятку, подключаемую непосредственно к монополярному разъёму стандартного электрохирургического генератора",
        "en": "The LightWave® design incorporates a one-piece molded handle, which is plugged directly into the monopolar port of a standard electrosurgical generator"
      },
      "image": "",
      "sourcePages": [
        59
      ],
      "bounds": [
