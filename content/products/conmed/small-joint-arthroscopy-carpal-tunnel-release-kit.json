  "features": [
    {
      "id": "feature-1",
      "title": {
        "ru": "CTS Relief комплект®",
        "en": "CTS Relief Kit®"
      },
      "text": {
        "ru": "Набор простых одноразовых инструментов для эндоскопического рассечения поперечной связки запястья через один портал",
        "en": "Provides the surgeon with a set of simple to use, disposable instruments for endoscopic release of the transverse carpal ligament through a single portal"
      },
      "image": "",
      "sourcePages": [
        66
      ],
      "bounds": [
        0.43568650890412025,
        0.16108087161311385,
