# Build output — recreated in full by `node build.mjs`
dist/

# Dependencies and environments
node_modules/
.venv-catalog/
.venv*/
__pycache__/
*.pyc

# rembg segmentation weights — downloaded on demand (~170 MB)
.rembg-models/

# 600-DPI OCR evidence, reproduced from the source PDFs by
# `scripts/import-catalog.py --ocr`. Nothing in the build or the site reads it.
# The sibling pages/ scans are NOT ignored: published systems reference them as
# source page images, so the build copies them into dist and the site serves
# them. Ignoring them broke the Vercel build with ENOENT on a fresh clone.
public/catalogs/*/*/ocr/

# Pre-enhancement image backups kept by scripts/enhance-catalog-images.py.
# Re-extractable from the source PDFs; never shipped in the public build.
**/_originals/

# macOS
.DS_Store

# Byte-identical copies of catalogs-source/*.pdf, recreated by build.mjs and by
# the importer. The originals in catalogs-source/ are the tracked ones.
public/catalogs/*/*/source.pdf
!public/catalogs/certificates/*/source.pdf

# Import evidence: OCR crops, contact sheets and raw per-page readings.
# Reproducible from the source PDFs, and nothing in the build or the tests
# reads them. The reports the tests and reviewers use stay tracked.
reports/**/*.png
reports/**/*.jpg
reports/**/*.jpeg
reports/**/*.webp
