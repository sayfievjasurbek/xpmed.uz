      "features": [
        {
          "text": "Tapered ends allow for easy insertion and removal of the dilators from the femoral or tibial tunnel",
          "bounds": [
            0.21339685605725617,
            0.25375971650121704,
            0.5475664049237832,
            0.26801986649664294
          ],
          "officialStartX": 125.2777099609375
        },
        {
          "text": "Full radiused depth marks from 10mm to 40mm, in 5mm increments T-Handle",
          "bounds": [
            0.21339661764656917,
            0.28095626139639335,
            0.5228664934060443,
            0.295195814893556
          ],
          "officialStartX": 125.2777099609375
        },
        {
          "text": "Ergonomic styling allows for an easy grip and maneuverability",
          "bounds": [
            0.21339626003053871,
            0.3217510787391578,
            0.5323994915000567,
            0.3359986007488507
          ],
          "officialStartX": 125.2777099609375
        },
        {
          "text": "Built in locking quick connector, allows for easy intraoperative changing, as well as minimizing the potential for the units to separate during use",
          "bounds": [
            0.21339612872913455,
            0.33534937003967497,
            0.4946043442215491,
            0.3495653567781164
          ],
          "officialStartX": 125.27770233154297
        },
        {
          "text": "Fully cannulated to 2.45mm diameter Slaphammer",
          "bounds": [
            0.21339578320899938,
            0.376144187392526,
            0.4349408861377792,
            0.3903104224120288
          ],
          "officialStartX": 125.2777099609375
        },
        {
          "text": "Ensures that the forces delivered to the dilator will be applied inline with the guide pin, thereby eliminating divergence during dilation",
          "bounds": [
            0.21339554479831238,
            0.4033407322877023,
            0.5721930623043926,
            0.4176214189886593
          ],
          "officialStartX": 125.2777099609375
        },
        {
          "text": "Fully cannulated to allow the assembly to be placed over guide pins up to 2.45mm diameter",
          "bounds": [
