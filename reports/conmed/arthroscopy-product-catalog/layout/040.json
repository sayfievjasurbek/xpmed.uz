      "features": [
        {
          "text": "For safe retrieval of semitendinosus and gracilis tendons for ACL and PCL reconstruction procedures",
          "bounds": [
            0.436951731115061,
            0.1619319851532256,
            0.840308275176238,
            0.17617416680490716
          ],
          "officialStartX": 266.2200012207031
        },
        {
          "text": "The 7mm and 6.6mm diameter openings allow for full thickness tendons to be harvested without damage to surrounding soft tissue",
          "bounds": [
            0.43692105809494336,
            0.18909645472310638,
            0.8942798868026262,
            0.20337575414822306
          ],
          "officialStartX": 266.2200012207031
        },
        {
          "text": "Closed design allows full, 360° enclosure for the tendon",
          "bounds": [
            0.4368903850641886,
            0.21626093371337476,
            0.7654123593359301,
            0.23045170126414025
          ],
          "officialStartX": 266.2200012207031
        },
        {
          "text": "Open Loop Design eliminates the need to thread tendon or sutures through a closed loop.",
          "bounds": [
