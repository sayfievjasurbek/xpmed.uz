      "features": [
        {
          "text": "Tapered head is suited for an endoscopic ACL technique whereby the femoral tunnel is reamed from inside-out while minimizing the risk of injury to the PCL",
          "bounds": [
            0.43604256156451776,
            0.15968172823852564,
            0.8780435930960074,
            0.17365307816885514
          ],
          "officialStartX": 265.5014953613281
        },
        {
          "text": "Drill bit shaft is etched in 15-120mm depth marks for easy identification of tunnel depth",
          "bounds": [
            0.4360007173193059,
            0.19237240883507217,
            0.868378335407619,
            0.20634403898244688
          ],
          "officialStartX": 265.5014953613281
        },
        {
          "text": "9\" length facilitates open femoral tunnel preparation and in-line tunnel reaming for endosteal fixation procedures",
          "bounds": [
            0.435958824598438,
            0.22506309886604398,
            0.8872800329178508,
            0.23903419597793565
          ],
          "officialStartX": 265.50146484375
        },
        {
          "text": "Head profile permits easy withdrawal from bone tunnels",
          "bounds": [
            0.4359169803411518,
            0.2577537888956521,
            0.7543514351692284,
            0.27172862518021235
          ],
          "officialStartX": 265.50146484375
        }
      ],
      "notes": [
        "Packaged sterile, limited reuse, 4 per box."
