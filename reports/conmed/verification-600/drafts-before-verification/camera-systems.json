  "features": [
    {
      "title": {
        "ru": "Чёткая визуализация",
        "en": "Vivid Visualization"
      },
      "text": {
        "ru": "КМОП-сенсоры обеспечивают повышенную светочувствительность, чёткое изображение и наиболее естественную цветопередачу при сложных хирургических вмешательствах.",
        "en": "CMOS chip sensors provides increased light sensitivity, crisp resolution and the most natural color spectrum for advanced surgical procedures."
      },
      "sourceBounds": [
        0.433099,
        0.163248,
        0.894953,
        0.203432
      ],
